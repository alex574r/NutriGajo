rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function rolDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.rol;
    }
    // Código de vinculación antes y después de la escritura en curso (el canje es un lote de dos escrituras).
    function codigoAntes(c) {
      return get(/databases/$(database)/documents/codigosVinculacion/$(c)).data;
    }
    function codigoDespues(c) {
      return getAfter(/databases/$(database)/documents/codigosVinculacion/$(c)).data;
    }
    function esAdmin() {
      return request.auth != null && rolDe(request.auth.uid) == 'ADMIN';
    }
    function verificacionRef(uid) {
      return /databases/$(database)/documents/verificaciones/$(uid);
    }
    function cedulaRef(cedula) {
      return /databases/$(database)/documents/cedulas/$(cedula);
    }
    // Solicitud de verificación que el propio nutriólogo envía (o reenvía tras un rechazo). Reserva su cédula
    // en el mismo lote (cedulas/{numero}), así una cédula no sirve en dos cuentas.
    function envioValido(uid) {
      let d = request.resource.data;
      let u = get(/databases/$(database)/documents/usuarios/$(uid)).data;
      return request.auth != null
        && request.auth.uid == uid
        && u.rol == 'NUTRIOLOGO'
        && u.verificado == false
        && d.keys().hasOnly(['nutriologoId', 'nombreCuenta', 'correo', 'nombreCedula', 'cedula', 'estado', 'enviadoEn'])
        && d.keys().hasAll(['nutriologoId', 'nombreCuenta', 'correo', 'nombreCedula', 'cedula', 'estado', 'enviadoEn'])
        && d.nutriologoId == uid
        && d.nombreCuenta == u.nombre
        && d.correo.lower() == request.auth.token.email.lower()
        && d.nombreCedula is string && d.nombreCedula.size() >= 3 && d.nombreCedula.size() <= 120
        && d.cedula is string && d.cedula.matches('[0-9]{6,8}')
        && d.estado == 'PENDIENTE'
        && d.enviadoEn is int
        && getAfter(cedulaRef(d.cedula)).data.nutriologoId == uid;
    }

    // Expediente del paciente (mapa dentro de pacientes/{id}): todo opcional, con tipos y rangos razonables.
    function expedienteValido(e) {
      return e.keys().hasOnly(['objetivo', 'sexo', 'fechaNacimiento', 'pesoKg', 'estaturaCm', 'nivelActividad',
                               'condiciones', 'alergias', 'dieta', 'diasEjercicio', 'ejercicios', 'suplementos',
                               'caloriasObjetivo', 'calidadSueno', 'paso', 'completo', 'actualizadoPor', 'actualizadoEn'])
        && e.get('paso', 0) is int && e.get('paso', 0) >= 0 && e.get('paso', 0) <= 30
        && e.get('completo', false) is bool
        && e.actualizadoEn is int
        && e.get('pesoKg', 70) is number && e.get('pesoKg', 70) >= 20 && e.get('pesoKg', 70) <= 500
        && e.get('estaturaCm', 170) is number && e.get('estaturaCm', 170) >= 50 && e.get('estaturaCm', 170) <= 260
        && e.get('nivelActividad', 1) is int && e.get('nivelActividad', 1) >= 1 && e.get('nivelActividad', 1) <= 5
        && e.get('diasEjercicio', 0) is int && e.get('diasEjercicio', 0) >= 0 && e.get('diasEjercicio', 0) <= 7
        && e.get('caloriasObjetivo', 2000) is int && e.get('caloriasObjetivo', 2000) >= 500 && e.get('caloriasObjetivo', 2000) <= 10000
        && e.get('fechaNacimiento', '2000-01-01') is string && e.get('fechaNacimiento', '2000-01-01').size() == 10
        && e.get('condiciones', []) is list && e.get('condiciones', []).size() <= 30
        && e.get('alergias', []) is list && e.get('alergias', []).size() <= 30
        && e.get('ejercicios', []) is list && e.get('ejercicios', []).size() <= 20
        && e.get('suplementos', []) is list && e.get('suplementos', []).size() <= 30;
    }

    // Metas diarias del paciente (mapa dentro de pacientes/{id}): agua en ml, pasos, calorías y minutos de movimiento, con quién
    // las dejó puestas (`por`) y cuándo. Los topes son los de la pantalla donde se ajustan (MetasDiarias).
    function metasValidas(m) {
      return m.keys().hasOnly(['aguaMl', 'pasos', 'kcal', 'minutos', 'por', 'actualizadoEn'])
        && m.keys().hasAll(['aguaMl', 'pasos', 'kcal', 'minutos', 'por', 'actualizadoEn'])
        && m.aguaMl is int && m.aguaMl >= 250 && m.aguaMl <= 6000
        && m.pasos is int && m.pasos >= 1000 && m.pasos <= 50000
        && m.kcal is int && m.kcal >= 200 && m.kcal <= 5000
        && m.minutos is int && m.minutos >= 5 && m.minutos <= 300
        && m.por in ['NUTRIOLOGO', 'PACIENTE']
        && m.actualizadoEn is int;
    }

    // Elemento del banco de comidas y ejercicios del nutriólogo: tipo, nombre, texto y, solo en las comidas, su tiempo de comida.
    // Los topes son los de ItemBanco y los de los campos del plan (500 caracteres).
    function bancoValido(d) {
      return d.keys().hasOnly(['tipo', 'momento', 'nombre', 'texto', 'creadoEn', 'actualizadoEn'])
        && d.keys().hasAll(['tipo', 'nombre', 'texto', 'creadoEn', 'actualizadoEn'])
        && d.tipo in ['COMIDA', 'EJERCICIO']
        && ((d.tipo == 'COMIDA' && 'momento' in d.keys() && d.momento in ['DESAYUNO', 'COMIDA', 'CENA'])
            || (d.tipo == 'EJERCICIO' && !('momento' in d.keys())))
        && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 80
        && d.texto is string && d.texto.size() >= 1 && d.texto.size() <= 500
        && d.creadoEn is int
        && d.actualizadoEn is int;
    }

    // Perfil de cuenta. ADMIN se da de alta a mano en la consola: nadie puede asignárselo al registrarse.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Solo el propio usuario crea su perfil, como NUTRIOLOGO o PACIENTE y sin verificar.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.rol in ['NUTRIOLOGO', 'PACIENTE']
        && request.resource.data.verificado == false
        && request.resource.data.activo == true
        && request.resource.data.correo.lower() == request.auth.token.email.lower();

      // El usuario edita sus datos, pero no su rol ni su verificación ni su estado.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.verificado == resource.data.verificado
        && request.resource.data.activo == resource.data.activo;

      // El ADMIN marca verificado a un nutriólogo solo al aprobar su solicitud, en el mismo lote.
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificado', 'ultimaModificacion'])
        && request.resource.data.verificado == true
        && get(verificacionRef(uid)).data.estado == 'PENDIENTE'
        && getAfter(verificacionRef(uid)).data.estado == 'APROBADA';

      allow delete: if false;
    }

    // Banco personal del nutriólogo: comidas y ejercicios que reutiliza al armar planes. Solo lo ve y lo edita su dueño. Un
    // elemento ya guardado no cambia de tipo ni de fecha de creación.
    match /usuarios/{uid}/banco/{itemId} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && rolDe(uid) == 'NUTRIOLOGO'
        && bancoValido(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && rolDe(uid) == 'NUTRIOLOGO'
        && bancoValido(request.resource.data)
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.creadoEn == resource.data.creadoEn;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Solicitud de verificación del nutriólogo (el id es su uid). La ven él y el ADMIN.
    match /verificaciones/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || rolDe(request.auth.uid) == 'ADMIN');

      allow create: if envioValido(uid);
      // reenvío: solo después de un rechazo
      allow update: if (resource.data.estado == 'RECHAZADA' && envioValido(uid))
        // revisión del ADMIN: una sola vez, de PENDIENTE a APROBADA o RECHAZADA (el rechazo lleva motivo)
        || (esAdmin()
            && resource.data.estado == 'PENDIENTE'
            && request.resource.data.estado in ['APROBADA', 'RECHAZADA']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivo', 'revisadoPor', 'revisadoEn', 'metodo'])
            && request.resource.data.revisadoPor == request.auth.uid
            && request.resource.data.revisadoEn is int
            && request.resource.data.metodo == 'MANUAL'
            && (request.resource.data.estado == 'APROBADA'
                || (request.resource.data.motivo is string
                    && request.resource.data.motivo.size() > 0
                    && request.resource.data.motivo.size() <= 200)));

      allow delete: if false;
    }

    // Reserva de cédula (el id es el número). Cualquier sesión puede consultar si está libre;
    // se crea con la solicitud y el ADMIN la libera al rechazarla.
    match /cedulas/{cedula} {
      allow get: if request.auth != null;

      allow create: if request.auth != null
        && rolDe(request.auth.uid) == 'NUTRIOLOGO'
        && request.resource.data.keys().hasOnly(['nutriologoId', 'creadoEn'])
        && request.resource.data.keys().hasAll(['nutriologoId', 'creadoEn'])
        && request.resource.data.nutriologoId == request.auth.uid
        && cedula.matches('[0-9]{6,8}')
        && getAfter(verificacionRef(request.auth.uid)).data.cedula == cedula;

      allow update: if false;

      allow delete: if esAdmin()
        && getAfter(verificacionRef(resource.data.nutriologoId)).data.estado == 'RECHAZADA'
        && getAfter(verificacionRef(resource.data.nutriologoId)).data.cedula == cedula;
    }

    // Dato de texto opcional del consultorio: si está, es texto de hasta `limite` caracteres.
    function textoOpcional(d, campo, limite) {
      return !(campo in d.keys()) || (d[campo] is string && d[campo].size() <= limite);
    }

    // Consultorio de un nutriólogo verificado en el mapa (el id es su uid). Lo ve cualquier sesión;
    // solo él lo publica, y solo mientras su cuenta esté verificada. La cédula tiene que ser la de su
    // solicitud aprobada, así un paciente la ve sin poder leer la solicitud. Los límites de texto son los de DatosConsultorio.
    match /directorio/{uid} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.rol == 'NUTRIOLOGO'
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.verificado == true
        && request.resource.data.keys().hasOnly(['nutriologoId', 'nombre', 'lat', 'lng', 'cedula', 'actualizadoEn',
                                                 'especialidad', 'direccion', 'telefono', 'horario', 'descripcion'])
        && request.resource.data.keys().hasAll(['nutriologoId', 'nombre', 'lat', 'lng', 'cedula', 'actualizadoEn'])
        && request.resource.data.nutriologoId == uid
        && request.resource.data.nombre == get(/databases/$(database)/documents/usuarios/$(uid)).data.nombre
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && get(verificacionRef(uid)).data.estado == 'APROBADA'
        && request.resource.data.cedula == get(verificacionRef(uid)).data.cedula
        && textoOpcional(request.resource.data, 'especialidad', 80)
        && textoOpcional(request.resource.data, 'direccion', 160)
        && textoOpcional(request.resource.data, 'telefono', 20)
        && textoOpcional(request.resource.data, 'horario', 120)
        && textoOpcional(request.resource.data, 'descripcion', 280)
        && request.resource.data.actualizadoEn is int;

      // quitarse del mapa
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    function citaRef(id) {
      return /databases/$(database)/documents/citas/$(id);
    }
    function directorioRef(uid) {
      return /databases/$(database)/documents/directorio/$(uid);
    }
    // Candado de «una sola cita vigente por paciente» (el id es el uid del paciente).
    function candadoRef(uid) {
      return /databases/$(database)/documents/citasActivas/$(uid);
    }
    // El paciente puede tomar una cita nueva: no tiene candado, o el que tiene es de una cita que ya pasó, se rechazó o se canceló.
    function candadoLibre(uid) {
      return !exists(candadoRef(uid))
        || get(citaRef(get(candadoRef(uid)).data.citaId)).data.inicio < request.time.toMillis()
        || get(citaRef(get(candadoRef(uid)).data.citaId)).data.estado in ['RECHAZADA', 'CANCELADA'];
    }

    // Hora ya pedida a un nutriólogo (el id es el inicio en milisegundos). La ve cualquier sesión para no ofrecerla;
    // no lleva datos del paciente. La crea el paciente en el mismo lote que su cita y, al ser el id el inicio, dos
    // pacientes no pueden tomar la misma hora: la segunda creación sería una actualización y se rechaza.
    // La libera el lote que rechaza o cancela la cita, o el que la cambia a otra hora (reagendar).
    match /directorio/{nutriologoId}/ocupados/{inicio} {
      allow read: if request.auth != null;

      // Se crea con la cita nueva o con la cita que cambia de hora: en ese caso la cita ya existe pero no tenía esta hora.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['citaId', 'inicio'])
        && request.resource.data.keys().hasAll(['citaId', 'inicio'])
        && request.resource.data.citaId is string
        && request.resource.data.inicio is int
        && string(request.resource.data.inicio) == inicio
        && (!exists(citaRef(request.resource.data.citaId))
            || get(citaRef(request.resource.data.citaId)).data.inicio != request.resource.data.inicio)
        && getAfter(citaRef(request.resource.data.citaId)).data.nutriologoId == nutriologoId
        && getAfter(citaRef(request.resource.data.citaId)).data.usuarioId == request.auth.uid
        && getAfter(citaRef(request.resource.data.citaId)).data.inicio == request.resource.data.inicio
        && getAfter(citaRef(request.resource.data.citaId)).data.estado == 'PENDIENTE';

      allow update: if false;

      // Se libera cuando la cita se rechaza o se cancela, o cuando el paciente la pasa a otra hora (la hora vieja queda libre).
      allow delete: if request.auth != null
        && (get(citaRef(resource.data.citaId)).data.nutriologoId == request.auth.uid
            || get(citaRef(resource.data.citaId)).data.usuarioId == request.auth.uid)
        && (getAfter(citaRef(resource.data.citaId)).data.estado in ['RECHAZADA', 'CANCELADA']
            || (getAfter(citaRef(resource.data.citaId)).data.estado == 'PENDIENTE'
                && getAfter(citaRef(resource.data.citaId)).data.inicio != resource.data.inicio));
    }

    // Candado de una sola cita vigente por paciente (el id es su uid): lo pone el paciente en el mismo lote que su cita nueva y
    // lo quita el lote que la rechaza o la cancela. Mientras exista, y su cita no haya pasado ni se haya cerrado, el paciente no
    // puede pedir otra (la regla de crear cita lo exige): puede reagendarla o cancelarla.
    match /citasActivas/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && rolDe(uid) == 'PACIENTE'
        && request.resource.data.keys().hasOnly(['citaId'])
        && request.resource.data.citaId is string
        && !exists(citaRef(request.resource.data.citaId))
        && getAfter(citaRef(request.resource.data.citaId)).data.usuarioId == uid
        && candadoLibre(uid);

      // Borrar uno que no existe no hace nada (citas de antes del candado).
      allow delete: if resource == null
        || (request.auth != null
            && (request.auth.uid == uid || get(citaRef(resource.data.citaId)).data.nutriologoId == request.auth.uid)
            && (getAfter(citaRef(resource.data.citaId)).data.estado in ['RECHAZADA', 'CANCELADA']
                || get(citaRef(resource.data.citaId)).data.inicio < request.time.toMillis()));
    }

    // Cita que un paciente pide a un nutriólogo del directorio. La ven los dos. El paciente la crea pendiente, con su
    // nombre y el del consultorio tal como están registrados; el nutriólogo confirma o rechaza lo pendiente y cancela lo
    // confirmado; el paciente cancela la suya o la reagenda a otra hora. Solo puede tener una vigente (citasActivas/{uid}).
    match /citas/{citaId} {
      allow read: if request.auth != null
        && (resource.data.nutriologoId == request.auth.uid || resource.data.usuarioId == request.auth.uid);

      allow create: if request.auth != null
        && rolDe(request.auth.uid) == 'PACIENTE'
        && request.resource.data.keys().hasOnly(['nutriologoId', 'nutriologoNombre', 'usuarioId', 'pacienteNombre',
                                                  'inicio', 'estado', 'creadaEn', 'actualizadaEn'])
        && request.resource.data.keys().hasAll(['nutriologoId', 'nutriologoNombre', 'usuarioId', 'pacienteNombre',
                                                 'inicio', 'estado', 'creadaEn', 'actualizadaEn'])
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.pacienteNombre == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nombre
        && request.resource.data.nutriologoNombre == get(directorioRef(request.resource.data.nutriologoId)).data.nombre
        && request.resource.data.estado == 'PENDIENTE'
        && request.resource.data.inicio is int
        && request.resource.data.inicio > request.time.toMillis()
        && request.resource.data.inicio <= request.time.toMillis() + 5184000000
        && request.resource.data.inicio % 900000 == 0
        && request.resource.data.creadaEn is int
        && request.resource.data.actualizadaEn is int
        && existsAfter(/databases/$(database)/documents/directorio/$(request.resource.data.nutriologoId)/ocupados/$(string(request.resource.data.inicio)))
        // una sola cita vigente: sin candado (o con uno vencido) y poniendo el de esta cita en el mismo lote
        && candadoLibre(request.auth.uid)
        && getAfter(candadoRef(request.auth.uid)).data.citaId == citaId;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizadaEn'])
        && request.resource.data.actualizadaEn is int
        && ((resource.data.nutriologoId == request.auth.uid
             && ((resource.data.estado == 'PENDIENTE' && request.resource.data.estado in ['CONFIRMADA', 'RECHAZADA'])
                 || (resource.data.estado == 'CONFIRMADA' && request.resource.data.estado == 'CANCELADA')))
            || (resource.data.usuarioId == request.auth.uid
                && resource.data.estado in ['PENDIENTE', 'CONFIRMADA']
                && request.resource.data.estado == 'CANCELADA'));

      // Reagendar: el paciente pasa su cita vigente a otra hora del mismo nutriólogo. Vuelve a PENDIENTE (el nutriólogo la
      // confirma de nuevo) y la hora nueva se reserva en el mismo lote; la vieja la libera el lote.
      allow update: if request.auth != null
        && resource.data.usuarioId == request.auth.uid
        && resource.data.estado in ['PENDIENTE', 'CONFIRMADA']
        && resource.data.inicio > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inicio', 'estado', 'actualizadaEn'])
        && request.resource.data.estado == 'PENDIENTE'
        && request.resource.data.inicio is int
        && request.resource.data.inicio != resource.data.inicio
        && request.resource.data.inicio > request.time.toMillis()
        && request.resource.data.inicio <= request.time.toMillis() + 5184000000
        && request.resource.data.inicio % 900000 == 0
        && request.resource.data.actualizadaEn is int
        && existsAfter(/databases/$(database)/documents/directorio/$(resource.data.nutriologoId)/ocupados/$(string(request.resource.data.inicio)))
        && getAfter(/databases/$(database)/documents/directorio/$(resource.data.nutriologoId)/ocupados/$(string(request.resource.data.inicio))).data.citaId == citaId;

      allow delete: if false;
    }

    // Códigos con los que un nutriólogo invita a un paciente. El id del documento es el código.
    match /codigosVinculacion/{codigo} {
      // Validar un código concreto lo puede hacer cualquier sesión; listarlos, solo su dueño.
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.nutriologoId == request.auth.uid;

      // Solo un nutriólogo crea códigos, a su nombre, sin usar y con vigencia de 7 días (más 1 de margen por relojes desajustados).
      allow create: if request.auth != null
        && rolDe(request.auth.uid) == 'NUTRIOLOGO'
        && request.resource.data.keys().hasOnly(['nutriologoId', 'nutriologoNombre', 'creadoEn', 'expiraEn', 'usado'])
        && request.resource.data.nutriologoId == request.auth.uid
        && request.resource.data.usado == false
        && request.resource.data.expiraEn > request.time.toMillis()
        && request.resource.data.expiraEn <= request.time.toMillis() + 691200000;

      // Canje: un paciente, una sola vez y antes de que venza; solo cambian los campos del canje.
      allow update: if request.auth != null
        && rolDe(request.auth.uid) == 'PACIENTE'
        && resource.data.usado == false
        && resource.data.expiraEn > request.time.toMillis()
        && request.resource.data.usado == true
        && request.resource.data.canjeadoPor == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado', 'canjeadoPor', 'canjeadoEn']);

      allow delete: if false;
    }

    // Registro del paciente ante su nutriólogo. Ven el registro el nutriólogo y el propio paciente.
    match /pacientes/{pacienteId} {
      allow read: if request.auth != null
        && (resource.data.nutriologoId == request.auth.uid || resource.data.usuarioId == request.auth.uid);

      // Alta por canje: el paciente crea su registro en el mismo lote que marca el código como usado,
      // y el nutriólogo sale del código, no de lo que escriba el cliente.
      allow create: if request.auth != null
        && rolDe(request.auth.uid) == 'PACIENTE'
        && request.resource.data.keys().hasOnly(['nutriologoId', 'nutriologoNombre', 'usuarioId', 'nombre',
                                                  'correoVinculacion', 'codigoVinculacion', 'activo',
                                                  'fechaAlta', 'ultimaModificacion'])
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.correoVinculacion.lower() == request.auth.token.email.lower()
        && request.resource.data.activo == true
        && request.resource.data.nutriologoId == codigoAntes(request.resource.data.codigoVinculacion).nutriologoId
        && codigoAntes(request.resource.data.codigoVinculacion).usado == false
        && codigoDespues(request.resource.data.codigoVinculacion).usado == true
        && codigoDespues(request.resource.data.codigoVinculacion).canjeadoPor == request.auth.uid;

      // Expediente: lo escriben el paciente y su nutriólogo, cada uno firmando con su rol; no se toca nada más del registro.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expediente', 'ultimaModificacion'])
        && expedienteValido(request.resource.data.expediente)
        && ((resource.data.usuarioId == request.auth.uid && request.resource.data.expediente.actualizadoPor == 'PACIENTE')
            || (resource.data.nutriologoId == request.auth.uid && request.resource.data.expediente.actualizadoPor == 'NUTRIOLOGO'));

      // Chat: el último mensaje queda resumido en el registro (autor, hora y un trozo del texto) para pintar el punto de «sin leer» y
      // la vista previa sin leer la conversación. Lo escribe quien envía el mensaje, en el mismo lote que el mensaje; no abre nada más.
      allow update: if request.auth != null
        && (resource.data.nutriologoId == request.auth.uid || resource.data.usuarioId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoMensaje'])
        && request.resource.data.ultimoMensaje.keys().hasOnly(['autorId', 'enviadoEn', 'texto', 'foto'])
        && request.resource.data.ultimoMensaje.keys().hasAll(['autorId', 'enviadoEn', 'texto', 'foto'])
        && request.resource.data.ultimoMensaje.autorId == request.auth.uid
        && request.resource.data.ultimoMensaje.enviadoEn is int
        && request.resource.data.ultimoMensaje.texto is string && request.resource.data.ultimoMensaje.texto.size() <= 120
        && request.resource.data.ultimoMensaje.foto is bool;

      // Metas diarias: las fija el nutriólogo del paciente y el propio paciente puede ajustarlas, cada uno firmando con su rol;
      // la última escritura manda y `por` dice de quién fue. No se toca nada más del registro.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['metas'])
        && metasValidas(request.resource.data.metas)
        && ((resource.data.usuarioId == request.auth.uid && request.resource.data.metas.por == 'PACIENTE')
            || (resource.data.nutriologoId == request.auth.uid && request.resource.data.metas.por == 'NUTRIOLOGO'));

      // Sin baja por ahora (llega con el archivado).
      allow delete: if false;
    }

    // Mensajes del chat entre el nutriólogo y su paciente: los ven y los escriben los dos, cada uno firmando con su cuenta. Un mensaje
    // lleva texto, foto (el archivo vive en R2, detrás del Worker) o las dos cosas, y ya no cambia ni se borra. `notificadaEn` lo
    // escribe el Worker al avisar a la otra persona.
    match /pacientes/{pacienteId}/mensajes/{mensajeId} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/pacientes/$(pacienteId)).data.nutriologoId == request.auth.uid
            || get(/databases/$(database)/documents/pacientes/$(pacienteId)).data.usuarioId == request.auth.uid);

      allow create: if request.auth != null
        && (get(/databases/$(database)/documents/pacientes/$(pacienteId)).data.nutriologoId == request.auth.uid
            || get(/databases/$(database)/documents/pacientes/$(pacienteId)).data.usuarioId == request.auth.uid)
        && request.resource.data.keys().hasOnly(['autorId', 'texto', 'foto', 'enviadoEn'])
        && request.resource.data.keys().hasAll(['autorId', 'texto', 'enviadoEn'])
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000
        && request.resource.data.enviadoEn is int
        && request.resource.data.get('foto', false) is bool
        && (request.resource.data.texto.size() > 0 || request.resource.data.get('foto', false) == true);

      allow update, delete: if false;
    }

    // Plan de alimentación y ejercicio que un nutriólogo envía a su paciente (el PDF vive en R2, detrás del Worker; aquí quedan
    // sus datos para armar el siguiente). Lo ven los dos; lo crea el nutriólogo del paciente, firmado con su nombre, y ya no cambia
    // ni se borra: cada cambio es un plan nuevo. `notificadaEn` lo escribe el Worker al avisar al paciente.
    match /pacientes/{pacienteId}/planes/{planId} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/pacientes/$(pacienteId)).data.nutriologoId == request.auth.uid
            || get(/databases/$(database)/documents/pacientes/$(pacienteId)).data.usuarioId == request.auth.uid);

      allow create: if request.auth != null
        && get(/databases/$(database)/documents/pacientes/$(pacienteId)).data.nutriologoId == request.auth.uid
        && request.resource.data.keys().hasOnly(['enviadoPor', 'nutriologoNombre', 'enviadoEn', 'titulo', 'contenido'])
        && request.resource.data.keys().hasAll(['enviadoPor', 'nutriologoNombre', 'enviadoEn', 'titulo', 'contenido'])
        && request.resource.data.enviadoPor == request.auth.uid
        && request.resource.data.nutriologoNombre == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nombre
        && request.resource.data.enviadoEn is int
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 120
        && request.resource.data.contenido is map;

      allow update, delete: if false;
    }

    // Comentarios que la gente envía desde Configuración (Enviar comentarios): cada quien escribe los suyos, firmados con su rol, y solo
    // el ADMIN los lee. Llevan las partes de la app de las que hablan (hasta 8) y un texto de hasta 1000 caracteres; uno de los dos al
    // menos. No se editan ni se borran.
    match /comentarios/{comentarioId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['usuarioId', 'rol', 'areas', 'mensaje', 'versionApp', 'creadoEn'])
        && request.resource.data.keys().hasAll(['usuarioId', 'rol', 'areas', 'mensaje', 'versionApp', 'creadoEn'])
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.rol == rolDe(request.auth.uid)
        && request.resource.data.areas is list && request.resource.data.areas.size() <= 8
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 1000
        && request.resource.data.versionApp is string && request.resource.data.versionApp.size() <= 40
        && request.resource.data.creadoEn is int
        && (request.resource.data.areas.size() > 0 || request.resource.data.mensaje.size() > 0);

      allow read: if esAdmin();

      allow update, delete: if false;
    }

    // Todo lo demás, denegado hasta definir sus reglas (mediciones, rutinas…).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
