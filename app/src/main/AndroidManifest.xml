<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ubicación aproximada para centrar el mapa en el usuario; es opcional y se pide al abrirlo -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Modo carrera: el GPS sigue registrando la ruta con la pantalla apagada; el servicio avisa con una notificación fija -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Reloj: pulso, entrenamientos, pasos, distancia, calorías activas, sueño y oxígeno que la app del reloj sincroniza con Health Connect (solo lectura) -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />

    <!-- Antes de Android 14 Health Connect es una app aparte: sin esto no se puede ver si está instalada -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Avisos de citas; desde Android 13 se pide al agendar la primera cita -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NutriGajo">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <!-- Cómo muestra FCM los avisos que llegan con la app cerrada; el canal es el mismo de Avisos.CANAL_CITAS y del Worker -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="citas" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_logo_mono" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/pulse_orange_50" />
        <service
            android:name=".data.push.NutriMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".data.carrera.ServicioCarrera"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- Widgets de la pantalla de inicio del teléfono: pulso, pasos, sueño, el resumen de hoy y el saludo con la racha -->
        <receiver
            android:name=".widgets.WidgetResumen"
            android:exported="false"
            android:label="@string/widget_resumen_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_resumen" />
        </receiver>
        <receiver
            android:name=".widgets.WidgetPulso"
            android:exported="false"
            android:label="@string/widget_pulso_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pulso" />
        </receiver>
        <receiver
            android:name=".widgets.WidgetPasos"
            android:exported="false"
            android:label="@string/widget_pasos_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pasos" />
        </receiver>
        <receiver
            android:name=".widgets.WidgetSueno"
            android:exported="false"
            android:label="@string/widget_sueno_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sueno" />
        </receiver>
        <receiver
            android:name=".widgets.WidgetSaludo"
            android:exported="false"
            android:label="@string/widget_saludo_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_saludo" />
        </receiver>
        <!-- La imagen que se comparte desde el modo carrera: se escribe en la caché y otra app la lee por este proveedor -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NutriGajo.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>